{"type": "elementor", "siteurl": "https://gototherapy.co.uk", "elements": [{"id": "9e35aee", "elType": "container", "settings": {"content_width": "boxed", "flex_direction": "column", "_css_classes": "gt-section gt-section--tight gt-hero", "flex_gap": {"column": "20", "row": "20", "unit": "px", "size": 20}}, "elements": [{"id": "7a3d54e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Application received", "header_size": "p", "_css_classes": "gt-eyebrow gt-eyebrow--ember"}, "elements": []}, {"id": "c6390bf", "elType": "widget", "widgetType": "heading", "settings": {"title": "Thank you. A person will take it from here.", "header_size": "h1", "_css_classes": "gt-h1"}, "elements": []}, {"id": "6118963", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Your application is in the queue for verification. Nothing is paid until your checks are complete and you have been accepted.</p>", "_css_classes": "gt-lead"}, "elements": []}], "isInner": false}, {"id": "c21ef66", "elType": "container", "settings": {"content_width": "boxed", "flex_direction": "column", "_css_classes": "gt-section gt-section--tight gt-section--flush-top", "flex_gap": {"column": "20", "row": "20", "unit": "px", "size": 20}}, "elements": [{"id": "924754e", "elType": "container", "settings": {"content_width": "full", "flex_direction": "row", "_css_classes": "gt-row", "flex_direction_tablet": "column", "flex_direction_mobile": "column", "flex_align_items": "center", "flex_gap": {"column": "48", "row": "32", "unit": "px", "size": 48}, "flex_gap_tablet": {"column": "32", "row": "32", "unit": "px", "size": 32}}, "elements": [{"id": "872400c", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "_css_classes": "gt-col", "flex_gap": {"column": "20", "row": "20", "unit": "px", "size": 20}, "width": {"unit": "%", "size": 50.0}, "width_tablet": {"unit": "%", "size": 100}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "b95210e", "elType": "widget", "widgetType": "heading", "settings": {"title": "What happens next", "header_size": "h2", "_css_classes": "gt-h2"}, "elements": []}, {"id": "f2a83fd", "elType": "widget", "widgetType": "html", "settings": {"html": "<ol class=\"steps\" style=\"list-style:none;padding:0;margin:2rem 0 0\">\n<li class=\"step\"><p aria-hidden=\"true\" class=\"numeral step__numeral\">01</p><h3 class=\"h3\">Email confirmation</h3><p class=\"step__body\">A confirmation email is sent to the address you gave. If it has not arrived, check your junk folder, then <a href=\"/complaints/\">get in touch</a>.</p></li>\n<li class=\"step\"><p aria-hidden=\"true\" class=\"numeral step__numeral\">02</p><h3 class=\"h3\">The checks</h3><p class=\"step__body\">A person checks your register entry against the register itself, looks at your insurance certificate, contacts your supervisor, and matches your identity to your register entry.</p></li>\n<li class=\"step\"><p aria-hidden=\"true\" class=\"numeral step__numeral\">03</p><h3 class=\"h3\">Outcome by email</h3><p class=\"step__body\">You are told which checks passed, and asked for anything still needed. If everything is complete, you are invited to set up membership.</p></li>\n<li class=\"step\"><p aria-hidden=\"true\" class=\"numeral step__numeral\">04</p><h3 class=\"h3\">Your profile goes live</h3><p class=\"step__body\">Once membership is active, your profile is published with the badge for your role. You manage it from your <a href=\"/account/\">account</a>.</p></li>\n</ol>"}, "elements": []}, {"id": "f6a0b29", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"placeholder\" style=\"margin-top:2rem\"><span class=\"placeholder__label\">Timeframe not stated</span>How long verification takes is supplied by the backend from real queue data, never typed here. Do not add an estimate to this page.</div>"}, "elements": []}], "isInner": true}, {"id": "c16fdf5", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "_css_classes": "gt-col", "flex_gap": {"column": "20", "row": "20", "unit": "px", "size": 20}, "width": {"unit": "%", "size": 50.0}, "width_tablet": {"unit": "%", "size": 100}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "4b87113", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "_css_classes": "gt-card", "flex_gap": {"column": "20", "row": "20", "unit": "px", "size": 20}}, "elements": [{"id": "49b5539", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>While you wait</p>", "_css_classes": ""}, "elements": []}, {"id": "ac5ba7b", "elType": "widget", "widgetType": "html", "settings": {"html": "<ul class=\"feature-list\" style=\"margin-top:1rem\">\n<li class=\"feature-list__item\"><span class=\"feature-list__icon\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><path d=\"M4 6h16M4 12h10M4 18h7\"></path></svg></span><div><p class=\"feature-list__title\">Read how verification works</p><p class=\"feature-list__text\"><a href=\"/how-we-verify/\">How we verify</a> explains every check, per role, and what the badge will say.</p></div></li>\n<li class=\"feature-list__item\"><span class=\"feature-list__icon\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><rect height=\"14\" rx=\"3\" width=\"18\" x=\"3\" y=\"5\"></rect><path d=\"M3 10h18\"></path></svg></span><div><p class=\"feature-list__title\">Membership and pricing</p><p class=\"feature-list__text\">Nothing is charged before acceptance. <a href=\"/pricing/\">What membership includes</a>.</p></div></li>\n<li class=\"feature-list__item\"><span class=\"feature-list__icon\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><path d=\"M21 12a9 9 0 1 1-9-9\"></path><path d=\"M21 3v6h-6\"></path></svg></span><div><p class=\"feature-list__title\">Something changed?</p><p class=\"feature-list__text\">If your insurance or supervision changes before we finish, reply to the confirmation email.</p></div></li>\n</ul>"}, "elements": []}], "isInner": true}], "isInner": true}], "isInner": true}], "isInner": false}]}