"f306e13", "elType": "widget", "widgetType": "html", "settings": {"html": "<ul class=\"profile-hero__meta\">\n<li><svg aria-hidden=\"true\" class=\"icon icon--sm\" viewbox=\"0 0 24 24\"><path d=\"M12 21s-6-5.2-6-10a6 6 0 0 1 12 0c0 4.8-6 10-6 10z\"></path><circle cx=\"12\" cy=\"11\" r=\"2\"></circle></svg><a href=\"/counselling/brighton/\">Brighton, East Sussex</a></li>\n<li><svg aria-hidden=\"true\" class=\"icon icon--sm\" viewbox=\"0 0 24 24\"><rect height=\"12\" rx=\"2\" width=\"13\" x=\"3\" y=\"6\"></rect><path d=\"m16 10 5-3v10l-5-3z\"></path></svg><span>In person and Online</span></li>\n<li><span class=\"status status--ok\">Taking new clients</span></li>\n</ul>"}, "elements": []}, {"id": "d6975bb", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"badge badge--verified\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Register, insurance and supervision checked</span></span>"}, "elements": []}, {"id": "3f25948", "elType": "widget", "widgetType": "html", "settings": {"html": "<span class=\"badge badge--demo\">Demo record</span>"}, "elements": []}], "isInner": true}, {"id": "edf85dd", "elType": "container", "settings": {"content_width": "full", "flex_direction": "column", "_css_classes": "gt-col", "flex_gap": {"column": "20", "row": "20", "unit": "px", "size": 20}, "width": {"unit": "%", "size": 50.0}, "width_tablet": {"unit": "%", "size": 100}, "width_mobile": {"unit": "%", "size": 100}}, "elements": [{"id": "8828f58", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Get in touch</p>", "_css_classes": ""}, "elements": []}, {"id": "09e7b7d", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Contact details are shown by the live system once you choose to reveal them. Nothing you write about yourself is stored by Gototherapy.</p>", "_css_classes": ""}, "elements": []}, {"id": "3703a3e", "elType": "widget", "widgetType": "button", "settings": {"text": "Request a session", "link": {"url": "#booking", "is_external": "", "nofollow": ""}, "_css_classes": "", "size": "md"}, "elements": []}, {"id": "f076b1a", "elType": "widget", "widgetType": "button", "settings": {"text": "See what was checked", "link": {"url": "#verification", "is_external": "", "nofollow": ""}, "_css_classes": "gt-button-ghost", "size": "md"}, "elements": []}, {"id": "cdc79d2", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Backend required: contact reveal via the Therapist API.</p>", "_css_classes": "gt-meta"}, "elements": []}], "isInner": true}], "isInner": true}], "isInner": false}, {"id": "c090cea", "elType": "container", "settings": {"content_width": "boxed", "flex_direction": "column", "_css_classes": "gt-section", "flex_gap": {"column": "20", "row": "20", "unit": "px", "size": 20}}, "elements": [{"id": "6f49d64", "elType": "widget", "widgetType": "html", "settings": {"html": "<!-- Functional block, kept verbatim. Replace with [gototherapy_profile] when the plugin is installed. -->\n<div data-page=\"profile\">\n<div class=\"container profile-layout\">\n<div class=\"profile-main\">\n<section aria-labelledby=\"who\" class=\"profile-section\">\n<h2 class=\"h3\" id=\"who\">Who I work with</h2>\n<div class=\"prose\"><p>Demo text. This paragraph shows where the member answers: who do you work with, and what do they usually come to you about? It is written by the member in the first person, 40 to 80 words, and is never edited into a claim.</p></div>\n</section>\n<section aria-labelledby=\"sessions\" class=\"profile-section\">\n<h2 class=\"h3\" id=\"sessions\">What a session with me is like</h2>\n<div class=\"prose\"><p>Demo text. This paragraph shows where the member describes what a session with them is actually like: the room, the pace, whether you talk or they ask, what the first meeting covers.</p></div>\n</section>\n<section aria-labelledby=\"drawn\" class=\"profile-section\">\n<h2 class=\"h3\" id=\"drawn\">What drew me to this work</h2>\n<div class=\"prose\"><p>Demo text. This paragraph shows where the member explains what drew them to this work, in their own words.</p></div>\n</section>\n<section aria-labelledby=\"before\" class=\"profile-section\">\n<h2 class=\"h3\" id=\"before\">What to know before you contact me</h2>\n<div class=\"prose\"><p>Demo text. This paragraph shows where the member says what somebody should know before contacting them: how they respond to enquiries, whether they offer an introductory call, and what they do not work with.</p></div>\n</section>\n<section aria-labelledby=\"approach\" class=\"profile-section\">\n<h2 class=\"h3\" id=\"approach\">How I work, in plain English</h2>\n<div class=\"modality\"><p class=\"modality__name\">Person-centred</p><p class=\"modality__desc\">You lead. The therapist listens closely, does not direct, and works on the idea that you are the best judge of what you need to talk about.</p></div><div class=\"modality\"><p class=\"modality__name\">Integrative</p><p class=\"modality__desc\">Draws on more than one approach depending on the person and the moment, rather than following a single method.</p></div>\n</section>\n<section aria-labelledby=\"issues\" class=\"profile-section\">\n<h2 class=\"h3\" id=\"issues\">Things people come to me about</h2>\n<ul class=\"chip-row\"><li><a class=\"chip chip--tap\" href=\"/counselling/anxiety/\">Anxiety</a></li><li><a class=\"chip chip--tap\" href=\"/counselling/work-stress/\">Work and stress</a></li><li><a class=\"chip chip--tap\" href=\"/counselling/self-esteem/\">Self-esteem</a></li><li><a class=\"chip chip--tap\" href=\"/counselling/relationships/\">Relationships</a></li></ul>\n</section>\n<section aria-labelledby=\"fees\" class=\"profile-section\">\n<h2 class=\"h3\" id=\"fees\">Fees</h2>\n<p class=\"mute\">This member has not published fees yet. Ask when you get in touch; you are allowed to ask about cost before anything else.</p>\n</section>\n<section aria-labelledby=\"verification-h\" class=\"profile-section\" id=\"verification\">\n<h2 class=\"h3\" id=\"verification-h\">What Gototherapy checked</h2>\n<p class=\"soft\">Checks are done by a person, per role, and rechecked every year. <a href=\"/how-we-verify/\">How verification works</a>.</p>\n<div data-verification-detail=\"\" style=\"margin-top:1rem\">\n<p class=\"mute\">Roles held: Therapist. Badge: Register, insurance and supervision checked.</p>\n</div>\n</section>\n<section aria-labelledby=\"booking-h\" class=\"profile-section\" id=\"booking\">\n<h2 class=\"h3\" id=\"booking-h\">Request a session</h2>\n<p class=\"soft\">Choose a day and a time. This sends a request; the therapist confirms or suggests another time. Nothing here is connected to a live calendar in this prototype.</p>\n<div class=\"booking\" data-booking=\"\" style=\"margin-top:1.25rem\">\n<fieldset class=\"form-fieldset\">\n<legend class=\"form-fieldset__legend\">Session type</legend>\n<div class=\"chip-row\">\n<label class=\"chip chip--tap\"><input name=\"session-mode\" style=\"accent-color:var(--slate)\" type=\"radio\" value=\"online\"/> Online</label>\n<label class=\"chip chip--tap\"><input name=\"session-mode\" style=\"accent-color:var(--slate)\" type=\"radio\" value=\"in-person\"/> In person</label>\n</div>\n</fieldset>\n<div>\n<p class=\"form-field__label\" id=\"dates-label\">Day</p>\n<div aria-labelledby=\"dates-label\" class=\"booking__dates\" data-booking-dates=\"\" role=\"group\"><p class=\"mute\">Loading availability…</p></div>\n</div>\n<div>\n<p class=\"form-field__label\" id=\"slots-label\">Time</p>\n<div aria-labelledby=\"slots-label\" class=\"booking__slots\" data-booking-slots=\"\" role=\"group\"></div>\n<ul class=\"booking__legend\" style=\"margin-top:.75rem\"><li><span></span> Available</li><li><span class=\"is-selected\"></span> Selected</li><li><span class=\"is-pending\"></span> Requested</li><li><span class=\"is-unavailable\"></span> Unavailable</li></ul>\n</div>\n<div class=\"booking__summary\" data-booking-summary=\"\"></div>\n<div class=\"form-actions\"><button class=\"button button--primary\" data-booking-request=\"\" disabled=\"\" type=\"button\">Request this time</button></div>\n<div data-booking-requests=\"\" hidden=\"\">\n<p class=\"form-field__label\">Your requests</p>\n<ul class=\"booking-list\" data-booking-list=\"\"></ul>\n</div>\n<p aria-live=\"polite\" class=\"visually-hidden\" data-booking-live=\"\"></p>\n<noscript><p class=\"note-panel\">Booking requires JavaScript. You can still contact this therapist directly.</p></noscript>\n</div>\n</section>\n</div>\n<aside aria-label=\"At a glance\" class=\"profile-aside\">\n<div class=\"card\">\n<p class=\"dashboard-card__label\">Practice hours</p>\n<div class=\"hours\" data-hours=\"member\" style=\"margin-top:.75rem\"><p class=\"mute\">Hours are calculated from this member’s availability.</p></div>\n</div>\n<div class=\"card\">\n<p class=\"dashboard-card__label\">Location and format</p>\n<p class=\"card__text\" style=\"margin-top:.5rem\">Brighton, East Sussex. In person and Online.</p>\n<p class=\"meta\" style=\"margin-top:.75rem\">Exact address is shared by the therapist once you are in touch.</p>\n</div>\n<div class=\"card\">\n<p class=\"dashboard-card__label\">No reviews here</p>\n<p class=\"card__text\" style=\"margin-top:.5rem\">Gototherapy does not carry reviews or ratings for anyone, by design. What we print is what we checked. <a href=\"/about/\">Why</a>.</p>\n</div>\n</aside>\n</div>\n</div>"}, "elements": []}], "isInner": false}, {"id": "1995322", "elType": "container", "settings": {"content_width": "boxed", "flex_direction": "column", "_css_classes": "gt-section--flush-top", "flex_gap": {"column": "20", "row": "20", "unit": "px", "size": 20}}, "elements": [{"id": "7a24129", "elType": "widget", "widgetType": "html", "settings": {"html": "<!-- Modal used by the functional block above -->\n<dialog aria-labelledby=\"booking-modal-title\" class=\"modal\" id=\"booking-modal\">\n<div class=\"modal__box\">\n<div class=\"modal__head\"><h2 class=\"h3 modal__title\" id=\"booking-modal-title\">Request sent</h2><button aria-label=\"Close\" class=\"modal__close\" data-modal-close=\"\" type=\"button\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><path d=\"M18 6 6 18M6 6l12 12\"></path></svg></button></div>\n<p id=\"booking-confirm-text\"></p>\n<p class=\"meta\">Backend required: POST /api/bookings creates the request and emails both parties.</p>\n<div class=\"modal__actions\"><button class=\"button button--primary\" data-modal-close=\"\" type=\"button\">Done</button></div>\n</div>\n</dialog>"}, "elements": []}], "isInner": false}]}