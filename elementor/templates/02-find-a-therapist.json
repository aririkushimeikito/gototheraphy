    {
     "id": "4f9572b",
     "elType": "widget",
     "widgetType": "heading",
     "settings": {
      "title": "Every therapist here has been checked by a person.",
      "header_size": "h1",
      "_css_classes": "gt-h1"
     },
     "elements": []
    },
    {
     "id": "85a8e48",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<p>Browse verified UK therapists and filter by town, by what you want help with, or by online sessions only. Each profile lists which checks were done: professional register, insurance, supervision and identity. Nothing is ranked and there are no reviews. You contact the therapist directly.</p>",
      "_css_classes": "gt-answer"
     },
     "elements": []
    }
   ],
   "isInner": false
  },
  {
   "id": "5831be3",
   "elType": "container",
   "settings": {
    "content_width": "boxed",
    "flex_direction": "column",
    "_css_classes": "gt-section gt-section--tight gt-section--flush-top",
