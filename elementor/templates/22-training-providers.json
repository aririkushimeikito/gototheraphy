    },
    {
     "id": "72fbf66",
     "elType": "widget",
     "widgetType": "heading",
     "settings": {
      "title": "Training providers whose accreditation has been checked.",
      "header_size": "h1",
      "_css_classes": "gt-h1"
     },
     "elements": []
    },
    {
     "id": "6f69e87",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<p>Training providers are organisations rather than individuals, so there is no personal register to check. Gototherapy confirms course accreditation with the awarding body, sees the organisation’s insurance certificate, and checks the identity of the named contact. The profile says plainly what was and was not checked.</p>",
      "_css_classes": "gt-answer"
     },
     "elements": []
    }
   ],
   "isInner": false
  },
  {
   "id": "fc48738",
   "elType": "container",
   "settings": {
    "content_width": "boxed",
