     "settings": {
      "html": "<!-- Functional block, kept verbatim. Replace with [gototherapy_member_account] when the plugin is installed. -->\n<div data-page=\"account\">\n<div class=\"container account-shell\" data-account=\"\">\n<aside aria-label=\"Account navigation\" class=\"account-side\">\n<div class=\"account-user\">\n<span aria-hidden=\"true\" class=\"avatar\" data-member-initials=\"\">–</span>\n<div><p class=\"account-user__name\" data-member-name=\"\">Loading…</p><p class=\"account-user__meta\" data-member-title=\"\"></p></div>\n</div>\n<nav aria-label=\"Account sections\" class=\"account-nav\">\n<a class=\"account-nav__link\" href=\"#dashboard\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><rect height=\"8\" rx=\"2\" width=\"8\" x=\"3\" y=\"3\"></rect><rect height=\"8\" rx=\"2\" width=\"8\" x=\"13\" y=\"3\"></rect><rect height=\"8\" rx=\"2\" width=\"8\" x=\"3\" y=\"13\"></rect><rect height=\"8\" rx=\"2\" width=\"8\" x=\"13\" y=\"13\"></rect></svg>Dashboard</a>\n<a class=\"account-nav__link\" href=\"#profile\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"4\"></circle><path d=\"M4 21c0-4 3.6-7 8-7s8 3 8 7\"></path></svg>Profile</a>\n<a class=\"account-nav__link\" href=\"#verification\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><path d=\"M9 12l2 2 4-4\"></path><path d=\"M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6z\"></path></svg>Verification</a>\n<a class=\"account-nav__link\" href=\"#availability\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><rect height=\"16\" rx=\"3\" width=\"18\" x=\"3\" y=\"5\"></rect><path d=\"M8 3v4m8-4v4M3 11h18\"></path></svg>Availability</a>\n<a class=\"account-nav__link\" href=\"#bookings\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"></circle><path d=\"M12 7v5l3 2\"></path></svg>Session requests</a>\n<a class=\"account-nav__link\" href=\"#billing\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><rect height=\"13\" rx=\"3\" width=\"18\" x=\"3\" y=\"6\"></rect><path d=\"M3 11h18M7 15h3\"></path></svg>Billing</a>\n<a class=\"account-nav__link\" href=\"#settings\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"3\"></circle><path d=\"M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z\"></path></svg>Account</a>\n</nav>\n<div class=\"state-demo\" style=\"margin-top:1.5rem;display:grid;gap:.5rem\">\n<label class=\"form-field__label\" for=\"member-switch\">Prototype: view as demo member</label>\n<select class=\"form-control form-control--select\" data-member-switch=\"\" id=\"member-switch\"></select>\n<p class=\"meta\" style=\"margin:0\">Backend required: the live account reads <code>GET /api/me</code> from the session.</p>\n</div>\n</aside>\n<div class=\"account-main\">\n<!-- Dashboard -->\n<section aria-labelledby=\"v-dash\" class=\"account-view is-active\" data-title=\"Dashboard\" data-view=\"dashboard\">\n<div class=\"account-view__head\"><div><p class=\"eyebrow\">Dashboard</p><h2 class=\"h2\" id=\"v-dash\">Where things stand</h2></div><a class=\"button button--ghost button--small\" href=\"/therapist/demo-therapist-a/\">View public profile</a></div>\n<div class=\"dashboard-grid dashboard-grid--3\">\n<div class=\"card dashboard-card\"><p class=\"dashboard-card__label\">Membership</p><div data-dash-membership=\"\"></div><div class=\"dashboard-card__foot\"><a class=\"text-link\" href=\"#billing\">Billing</a></div></div>\n<div class=\"card dashboard-card\"><p class=\"dashboard-card__label\">Verification</p><div data-dash-verification=\"\"></div><div class=\"dashboard-card__foot\"><a class=\"text-link\" href=\"#verification\">Documents and expiry dates</a></div></div>\n<div class=\"card dashboard-card\"><p class=\"dashboard-card__label\">Profile completion</p><div data-dash-profile=\"\"></div><div class=\"dashboard-card__foot\"><a class=\"text-link\" href=\"#profile\">Edit profile</a></div></div>\n<div class=\"card dashboard-card\"><p class=\"dashboard-card__label\">New clients</p><div data-dash-availability=\"\"></div><div class=\"dashboard-card__foot\"><a class=\"text-link\" href=\"#availability\">Availability</a></div></div>\n<div class=\"card dashboard-card\"><p class=\"dashboard-card__label\">Visibility</p><div data-dash-visibility=\"\"></div><div class=\"dashboard-card__foot\"><a class=\"text-link\" href=\"/find-a-therapist/\">Search as a visitor</a></div></div>\n<div class=\"card dashboard-card\"><p class=\"dashboard-card__label\">Your practice hours</p><div class=\"hours\" data-hours=\"member\"></div><p class=\"dashboard-card__text\">Computed live from your weekly availability.</p></div>\n<div class=\"card dashboard-card dashboard-card--wide\"><p class=\"dashboard-card__label\">Member support</p><div class=\"hours\" data-hours=\"support\"></div><p class=\"dashboard-card__text\">Support hours are a single configuration object in <code>assets/js/hours.js</code>, ready to be replaced by backend data.</p></div>\n</div>\n</section>\n<!-- Profile -->\n<section aria-labelledby=\"v-profile\" class=\"account-view\" data-title=\"Profile\" data-view=\"profile\">\n<div class=\"account-view__head\"><div><p class=\"eyebrow\">Profile</p><h2 class=\"h2\" id=\"v-profile\">Your public profile</h2></div></div>\n<form novalidate=\"\">\n<div class=\"form-section\">\n<h2 class=\"h3\">Role and location</h2>\n<div class=\"form-group form-group--2\">\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"pf-title\">Professional title</label><input class=\"form-control\" id=\"pf-title\" name=\"title\" required=\"\" type=\"text\"/></div>\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"pf-town\">Town or city</label><input class=\"form-control\" id=\"pf-town\" name=\"town\" required=\"\" type=\"text\"/></div>\n</div>\n<div class=\"form-group form-group--2\">\n<label class=\"switch\"><input name=\"online\" type=\"checkbox\"/><span aria-hidden=\"true\" class=\"switch__track\"></span><span class=\"switch__label\">I offer online sessions</span></label>\n<label class=\"switch\"><input name=\"inperson\" type=\"checkbox\"/><span aria-hidden=\"true\" class=\"switch__track\"></span><span class=\"switch__label\">I offer in-person sessions</span></label>\n<label class=\"switch\"><input name=\"accepting\" type=\"checkbox\"/><span aria-hidden=\"true\" class=\"switch__track\"></span><span class=\"switch__label\">Taking new clients</span></label>\n</div>\n</div>\n<div class=\"form-section\">\n<h2 class=\"h3\">Photo</h2>\n<p class=\"form-section__desc\">Your profile is only indexed by search engines with a real photograph of you. Never a stock image. Until then your initials are shown.</p>\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"pf-photo\">Upload a photograph</label><input accept=\"image/*\" class=\"form-control form-control--file\" id=\"pf-photo\" name=\"photo\" type=\"file\"/><p class=\"form-field__hint\">Backend required: <code>POST /api/me/photo</code>. Nothing is uploaded in the prototype.</p></div>\n</div>\n<div class=\"form-section\">\n<h2 class=\"h3\">In your words</h2>\n<p class=\"form-section__desc\">Four questions, 40 to 80 words each, first person. No promises about outcomes.</p>\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"pf-1\">Who do you work with, and what do they usually come to you about?</label><textarea class=\"form-control\" id=\"pf-1\" name=\"worksWith\" rows=\"4\"></textarea></div>\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"pf-2\">What is a session with you actually like?</label><textarea class=\"form-control\" id=\"pf-2\" name=\"sessions\" rows=\"4\"></textarea></div>\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"pf-3\">What drew you to this work?</label><textarea class=\"form-control\" id=\"pf-3\" name=\"drawnTo\" rows=\"4\"></textarea></div>\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"pf-4\">What should somebody know before they contact you?</label><textarea class=\"form-control\" id=\"pf-4\" name=\"beforeContact\" rows=\"4\"></textarea></div>\n</div>\n<div class=\"form-section\">\n<h2 class=\"h3\">Issues you work with</h2>\n<div class=\"grid grid--2\" data-issue-options=\"\"></div>\n</div>\n<div class=\"form-section\">\n<h2 class=\"h3\">Your approach</h2>\n<p class=\"form-section__desc\">Each approach prints its plain-English explanation on your profile, so nobody lists a modality without saying what it means.</p>\n<div class=\"grid\" data-modality-options=\"\"></div>\n</div>\n<div class=\"form-section\">\n<h2 class=\"h3\">Fees</h2>\n<p class=\"form-section__desc\">Fees shown on the site are what you enter here. Ranges on directory pages are computed from members’ entries, never typed.</p>\n<div class=\"form-group form-group--2\">\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"pf-fee\">Fee per session (GBP)</label><input class=\"form-control\" id=\"pf-fee\" inputmode=\"numeric\" min=\"0\" name=\"fee\" step=\"1\" type=\"number\"/></div>\n<label class=\"switch\"><input name=\"concessions\" type=\"checkbox\"/><span aria-hidden=\"true\" class=\"switch__track\"></span><span class=\"switch__label\">Some concessionary places</span></label>\n</div>\n</div>\n<div class=\"form-actions\"><button class=\"button button--primary\" type=\"submit\">Save profile</button><span class=\"meta\">Backend required: <code>PATCH /api/me/profile</code>.</span></div>\n</form>\n</section>\n<!-- Verification -->\n<section aria-labelledby=\"v-ver\" class=\"account-view\" data-title=\"Verification\" data-view=\"verification\">\n<div class=\"account-view__head\"><div><p class=\"eyebrow\">Verification</p><h2 class=\"h2\" id=\"v-ver\">What has been checked</h2></div></div>\n<div class=\"dashboard-grid\">\n<div class=\"card dashboard-card dashboard-card--wide\">\n<div data-verification-badge=\"\"></div>\n<div data-verification-list=\"\" style=\"margin-top:1rem\"></div>\n</div>\n<div class=\"card dashboard-card\"><p class=\"dashboard-card__label\">Expiry dates</p><ul class=\"verify-list\" data-expiry-list=\"\" style=\"margin-top:.5rem\"></ul><p class=\"dashboard-card__text\">We email you before anything expires. Upload the renewal here and a person rechecks it.</p></div>\n<div class=\"card dashboard-card\"><p class=\"dashboard-card__label\">Verification history</p><ul class=\"timeline\" data-verification-history=\"\" style=\"margin-top:.75rem\"></ul></div>\n<div class=\"card dashboard-card dashboard-card--wide\"><p class=\"dashboard-card__label\">Documents</p><p class=\"dashboard-card__text\">Documents are held in private storage and viewed only by the person doing the check. Identity images are deleted after the check.</p><ul class=\"doc-list\" data-document-list=\"\" style=\"margin-top:.75rem\"></ul></div>\n</div>\n</section>\n<!-- Availability -->\n<section aria-labelledby=\"v-av\" class=\"account-view\" data-title=\"Availability\" data-view=\"availability\">\n<div class=\"account-view__head\"><div><p class=\"eyebrow\">Availability</p><h2 class=\"h2\" id=\"v-av\">When you work</h2></div></div>\n<form novalidate=\"\">\n<div class=\"form-section\">\n<h2 class=\"h3\">Status</h2>\n<div class=\"form-group form-group--2\">\n<label class=\"switch\"><input name=\"accepting\" type=\"checkbox\"/><span aria-hidden=\"true\" class=\"switch__track\"></span><span class=\"switch__label\">Taking new clients</span></label>\n<label class=\"switch\"><input name=\"mode-online\" type=\"checkbox\"/><span aria-hidden=\"true\" class=\"switch__track\"></span><span class=\"switch__label\">Online sessions</span></label>\n<label class=\"switch\"><input name=\"mode-inperson\" type=\"checkbox\"/><span aria-hidden=\"true\" class=\"switch__track\"></span><span class=\"switch__label\">In-person sessions</span></label>\n</div>\n</div>\n<div class=\"form-section\">\n<h2 class=\"h3\">Weekly hours</h2>\n<p class=\"form-section__desc\">Used for the practice hours shown on your profile and for the session-request calendar. Times are UK time.</p>\n<div class=\"avail-grid\" data-avail-rows=\"\"></div>\n</div>\n<div class=\"form-section\">\n<h2 class=\"h3\">Appointment settings</h2>\n<div class=\"form-group form-group--2\">\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"av-length\">Session length</label><select class=\"form-control form-control--select\" id=\"av-length\" name=\"length\"><option>50 minutes</option><option>60 minutes</option><option>90 minutes</option></select></div>\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"av-notice\">Minimum notice for a request</label><select class=\"form-control form-control--select\" id=\"av-notice\" name=\"notice\"><option>24 hours</option><option>48 hours</option><option>1 week</option></select></div>\n</div>\n<div class=\"note-panel\"><p class=\"note-panel__title\">Calendar sync</p><p>Backend required: connect Google Calendar or Microsoft 365 via <code>POST /api/me/calendar/connect</code> so confirmed sessions block time automatically. Not connected in the prototype.</p></div>\n</div>\n<div class=\"form-actions\"><button class=\"button button--primary\" type=\"submit\">Save availability</button><span class=\"meta\">Backend required: <code>PUT /api/me/availability</code>.</span></div>\n</form>\n</section>\n<!-- Bookings -->\n<section aria-labelledby=\"v-bk\" class=\"account-view\" data-title=\"Session requests\" data-view=\"bookings\">\n<div class=\"account-view__head\"><div><p class=\"eyebrow\">Session requests</p><h2 class=\"h2\" id=\"v-bk\">Requests from people who found you</h2></div></div>\n<p class=\"soft\" style=\"max-width:60ch;margin-bottom:1.5rem\">Confirming sends both of you an email. Declining does too, without a reason attached. Gototherapy stores the time and format, nothing about the person’s reasons for coming.</p>\n<div data-bookings=\"\"></div>\n</section>\n<!-- Billing -->\n<section aria-labelledby=\"v-bill\" class=\"account-view\" data-title=\"Billing\" data-view=\"billing\">\n<div class=\"account-view__head\"><div><p class=\"eyebrow\">Billing</p><h2 class=\"h2\" id=\"v-bill\">Membership and payments</h2></div></div>\n<div class=\"billing-summary\">\n<div class=\"card dashboard-card\" data-billing-plan=\"\"></div>\n<div class=\"card dashboard-card\" data-billing-status=\"\"></div>\n</div>\n<div class=\"form-actions\" data-billing-actions=\"\"></div>\n<div class=\"state-demo\" style=\"margin-top:1.5rem\">\n<label for=\"sub-state\">Prototype: simulate a subscription state</label>\n<select class=\"form-control form-control--select\" data-state-select=\"\" id=\"sub-state\" style=\"width:auto\"><option value=\"incomplete\">Payment pending</option><option value=\"trialing\">Trial</option><option value=\"active\">Active</option><option value=\"past_due\">Payment failed (past due)</option><option value=\"unpaid\">Unpaid</option><option value=\"canceled\">Cancelled</option></select>\n<span>States mirror Stripe’s subscription status. See BACKEND-INTEGRATION.md.</span>\n</div>\n<h2 class=\"h3\" style=\"margin-top:2.5rem\">Billing history</h2>\n<div class=\"table-wrap\" style=\"margin-top:1rem\"><table class=\"table\"><thead><tr><th scope=\"col\">Date</th><th scope=\"col\">Invoice</th><th scope=\"col\">Amount</th><th scope=\"col\">Status</th><th scope=\"col\">Receipt</th></tr></thead><tbody data-invoice-rows=\"\"></tbody></table></div>\n<div class=\"note-panel\" style=\"margin-top:1.5rem\"><p class=\"note-panel__title\">Card details never touch this site</p><p>Payments are handled by Stripe Checkout and the Stripe Billing Portal. Gototherapy stores a customer reference and the subscription status only. <a href=\"/cancellation-and-refunds/\">Cancellation and refunds policy</a>.</p></div>\n</section>\n<!-- Settings -->\n<section aria-labelledby=\"v-set\" class=\"account-view\" data-title=\"Account\" data-view=\"settings\">\n<div class=\"account-view__head\"><div><p class=\"eyebrow\">Account</p><h2 class=\"h2\" id=\"v-set\">Personal details and security</h2></div></div>\n<form data-demo-form=\"\" data-success-message=\"Details saved (prototype).\" novalidate=\"\">\n<div class=\"form-section\">\n<h2 class=\"h3\">Personal details</h2>\n<div class=\"form-group form-group--2\">\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"ac-name\">Name on your register entry</label><input class=\"form-control\" id=\"ac-name\" name=\"name\" required=\"\" type=\"text\" value=\"Demo Member\"/><p aria-live=\"polite\" class=\"form-field__error\"></p></div>\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"ac-email\">Email</label><input class=\"form-control\" id=\"ac-email\" name=\"email\" required=\"\" type=\"email\" value=\"demo@example.invalid\"/><p aria-live=\"polite\" class=\"form-field__error\"></p></div>\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"ac-phone\">Phone</label><input class=\"form-control\" id=\"ac-phone\" name=\"phone\" type=\"tel\"/></div>\n</div>\n</div>\n<div class=\"form-actions\"><button class=\"button button--primary\" type=\"submit\">Save details</button></div>\n</form>\n<form data-demo-form=\"\" data-success-message=\"Password changed (prototype).\" novalidate=\"\" style=\"margin-top:2.5rem\">\n<div class=\"form-section\">\n<h2 class=\"h3\">Password</h2>\n<div class=\"form-group form-group--2\">\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"ac-pw-current\">Current password</label><input autocomplete=\"current-password\" class=\"form-control\" id=\"ac-pw-current\" name=\"current\" required=\"\" type=\"password\"/><p aria-live=\"polite\" class=\"form-field__error\"></p></div>\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"ac-pw-new\">New password</label><div class=\"input-with-button\"><input autocomplete=\"new-password\" class=\"form-control\" id=\"ac-pw-new\" minlength=\"12\" name=\"new\" required=\"\" type=\"password\"/><button aria-label=\"Show password\" aria-pressed=\"false\" class=\"input-with-button__button\" data-password-toggle=\"ac-pw-new\" type=\"button\"><svg aria-hidden=\"true\" class=\"icon icon--sm\" viewbox=\"0 0 24 24\"><path d=\"M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg></button></div><p aria-live=\"polite\" class=\"form-field__error\"></p></div>\n</div>\n</div>\n<div class=\"form-actions\"><button class=\"button button--primary\" type=\"submit\">Change password</button><span class=\"meta\">Backend required: <code>POST /api/auth/password</code>.</span></div>\n</form>\n<form data-demo-form=\"\" data-success-message=\"Notification preferences saved (prototype).\" novalidate=\"\" style=\"margin-top:2.5rem\">\n<div class=\"form-section\">\n<h2 class=\"h3\">Notifications</h2>\n<label class=\"switch\"><input checked=\"\" name=\"n-requests\" type=\"checkbox\"/><span aria-hidden=\"true\" class=\"switch__track\"></span><span class=\"switch__label\">Email me about session requests</span></label>\n<label class=\"switch\"><input checked=\"\" disabled=\"\" name=\"n-expiry\" type=\"checkbox\"/><span aria-hidden=\"true\" class=\"switch__track\"></span><span class=\"switch__label\">Email me before a document expires (always on: it keeps your listing live)</span></label>\n<label class=\"switch\"><input checked=\"\" disabled=\"\" name=\"n-billing\" type=\"checkbox\"/><span aria-hidden=\"true\" class=\"switch__track\"></span><span class=\"switch__label\">Email me about payments (always on)</span></label>\n<label class=\"switch\"><input name=\"n-news\" type=\"checkbox\"/><span aria-hidden=\"true\" class=\"switch__track\"></span><span class=\"switch__label\">Occasional updates about Gototherapy</span></label>\n</div>\n<div class=\"form-actions\"><button class=\"button button--primary\" type=\"submit\">Save preferences</button></div>\n</form>\n<div class=\"form-section\" style=\"margin-top:2.5rem\">\n<h2 class=\"h3\">Sign out</h2>\n<div class=\"form-actions\"><button class=\"button button--ghost\" data-signout=\"\" type=\"button\">Sign out of this device</button></div>\n</div>\n</section>\n</div>\n</div>\n</div>"
     },
     "elements": []
    }
   ],
   "isInner": false
  },
