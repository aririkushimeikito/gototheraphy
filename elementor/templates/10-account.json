     "settings": {
      "html": "<!-- Modal used by the functional block above -->\n<dialog aria-labelledby=\"upload-title\" class=\"modal\" id=\"upload-modal\">\n<div class=\"modal__box\">\n<div class=\"modal__head\"><h2 class=\"h3 modal__title\" id=\"upload-title\">Replace document</h2><button aria-label=\"Close\" class=\"modal__close\" data-modal-close=\"\" type=\"button\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><path d=\"M18 6 6 18M6 6l12 12\"></path></svg></button></div>\n<form id=\"upload-form\" novalidate=\"\">\n<p class=\"soft\">Upload the renewed document for <strong id=\"upload-modal-check\">this check</strong>. A person rechecks it and your history is updated.</p>\n<div class=\"form-field\" style=\"margin-top:1rem\"><label class=\"form-field__label\" for=\"upload-file\">File (PDF or image)</label><input accept=\".pdf,image/*\" class=\"form-control form-control--file\" id=\"upload-file\" name=\"file\" required=\"\" type=\"file\"/></div>\n<div class=\"modal__actions\"><button class=\"button button--ghost\" data-modal-close=\"\" type=\"button\">Cancel</button><button class=\"button button--primary\" type=\"submit\">Upload for review</button></div>\n<p class=\"meta\" style=\"margin-top:1rem\">Backend required: <code>POST /api/me/documents</code> to private storage. Nothing is uploaded in the prototype.</p>\n</form>\n</div>\n</dialog>"
