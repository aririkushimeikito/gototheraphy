   "elements": [
    {
     "id": "d3fc4d8",
     "elType": "widget",
     "widgetType": "heading",
     "settings": {
      "title": "About",
      "header_size": "p",
      "_css_classes": "gt-eyebrow"
     },
     "elements": []
    },
    {
     "id": "3cee9b9",
     "elType": "widget",
     "widgetType": "heading",
     "settings": {
      "title": "Every therapist here has been checked by a person.",
      "header_size": "h1",
      "_css_classes": "gt-h1"
     },
     "elements": []
    },
    {
     "id": "bcca0fc",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<p>Gototherapy is a UK directory of therapists, supervisors, coaches and trainers. It exists because most directories let anyone list, and most people cannot tell a register entry from a certificate. Here, a person checks each member's registration, insurance and supervision, rechecks them every year, and prints what was checked on the profile. There are no reviews or ratings.</p>",
      "_css_classes": "gt-answer"
     },
     "elements": []
    }
   ],
   "isInner": false
  },
  {
