   "elements": [
    {
     "id": "9cb3aca",
     "elType": "widget",
     "widgetType": "heading",
     "settings": {
      "title": "What Gototherapy does and does not do",
      "header_size": "h2",
      "_css_classes": "gt-h2"
     },
     "elements": []
    },
    {
     "id": "c23db7c",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<ul class=\"rows\" style=\"margin-top:2rem\">\n<li class=\"rows__item\"><p class=\"rows__term\">Does</p><p class=\"rows__desc\">Check each member's register entry, insurance certificate, supervision arrangement and identity, per role, and repeat the checks annually.</p></li>\n<li class=\"rows__item\"><p class=\"rows__term\">Does</p><p class=\"rows__desc\">Print what was checked, when, and what the badge for that role means.</p></li>\n<li class=\"rows__item\"><p class=\"rows__term\">Does</p><p class=\"rows__desc\">Compute counts, fee ranges and availability from live member data rather than typing numbers that go stale.</p></li>\n<li class=\"rows__item\"><p class=\"rows__term\">Does not</p><p class=\"rows__desc\">Provide therapy, recommend individual therapists, or rank anyone by popularity or payment.</p></li>\n<li class=\"rows__item\"><p class=\"rows__term\">Does not</p><p class=\"rows__desc\">Carry reviews, ratings, testimonials or enquiry forms.</p></li>\n<li class=\"rows__item\"><p class=\"rows__term\">Does not</p><p class=\"rows__desc\">Act as an emergency service. If you need help now, see <a href=\"/crisis/\">urgent support</a>.</p></li>\n</ul>"
     },
     "elements": []
    },
