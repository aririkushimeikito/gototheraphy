     "id": "5d694c1",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<!-- Modal used by the functional block above -->\n<dialog aria-labelledby=\"forgot-title\" class=\"modal\" id=\"forgot-modal\">\n<div class=\"modal__box\">\n<div class=\"modal__head\"><h2 class=\"h3 modal__title\" id=\"forgot-title\">Reset your password</h2><button aria-label=\"Close\" class=\"modal__close\" data-modal-close=\"\" type=\"button\"><svg aria-hidden=\"true\" class=\"icon\" viewbox=\"0 0 24 24\"><path d=\"M18 6 6 18M6 6l12 12\"></path></svg></button></div>\n<form data-demo-form=\"\" data-success-message=\"If that address has an account, a reset link is on its way (prototype: nothing sent).\" novalidate=\"\">\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"reset-email\">Email</label><p class=\"form-field__hint\" id=\"reset-hint\">We send a link that expires. We never send passwords by email.</p><input aria-describedby=\"reset-hint\" class=\"form-control\" id=\"reset-email\" name=\"email\" required=\"\" type=\"email\"/><p aria-live=\"polite\" class=\"form-field__error\"></p></div>\n<div class=\"modal__actions\"><button class=\"button button--ghost\" data-modal-close=\"\" type=\"button\">Cancel</button><button class=\"button button--primary\" type=\"submit\">Send reset link</button></div>\n<p class=\"meta\" style=\"margin-top:1rem\">Backend required: <code>POST /api/auth/password-reset</code>.</p>\n</form>\n</div>\n</dialog>"
     },
     "elements": []
    }
   ],
   "isInner": false
  }
