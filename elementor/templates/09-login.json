     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<!-- Functional block, kept verbatim. Replace with [gototherapy_sign_in] when the plugin is installed. -->\n<div data-page=\"login\">\n<section class=\"auth\">\n<div class=\"container\">\n<div class=\"auth__box\">\n<p class=\"eyebrow\">Member account</p>\n<h1 class=\"h2\">Log in</h1>\n<p class=\"lead\">For professionals listed on Gototherapy. People looking for a therapist do not need an account.</p>\n<form action=\"/account/\" class=\"auth__form\" data-login-form=\"\" method=\"post\" novalidate=\"\">\n<div class=\"form-summary\" role=\"alert\"></div>\n<div class=\"form-group\">\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"login-email\">Email</label><input autocomplete=\"username\" class=\"form-control\" id=\"login-email\" inputmode=\"email\" name=\"email\" required=\"\" type=\"email\"/><p aria-live=\"polite\" class=\"form-field__error\"></p></div>\n<div class=\"form-field\"><label class=\"form-field__label\" for=\"login-password\">Password</label><div class=\"input-with-button\"><input autocomplete=\"current-password\" class=\"form-control\" id=\"login-password\" name=\"password\" required=\"\" type=\"password\"/><button aria-label=\"Show password\" aria-pressed=\"false\" class=\"input-with-button__button\" data-password-toggle=\"login-password\" type=\"button\"><svg aria-hidden=\"true\" class=\"icon icon--sm\" viewbox=\"0 0 24 24\"><path d=\"M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z\"></path><circle cx=\"12\" cy=\"12\" r=\"3\"></circle></svg></button></div><p aria-live=\"polite\" class=\"form-field__error\"></p></div>\n<label class=\"form-check\"><input name=\"remember\" type=\"checkbox\" value=\"1\"/><span class=\"form-check__label\">Keep me signed in on this device</span></label>\n</div>\n<div class=\"form-actions\"><button class=\"button button--primary button--block\" type=\"submit\">Sign in</button></div>\n<p class=\"meta\" style=\"margin-top:1rem\">Prototype: no credentials are checked or stored. Sign in opens the demonstration account. Backend required: <code>POST /api/auth/login</code> setting an httpOnly session cookie.</p>\n</form>\n<div class=\"auth__links\">\n<a class=\"text-link\" data-modal-open=\"forgot-modal\" href=\"#forgot\">Forgotten your password?</a>\n<a class=\"text-link\" href=\"/join/\">Create an account by applying to join</a>\n</div>\n</div>\n</div>\n</section>\n</div>"
     },
     "elements": []
    }
   ],
   "isInner": false
  },
