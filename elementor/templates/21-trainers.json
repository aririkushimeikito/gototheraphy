   "elements": [
    {
     "id": "eaa60c7",
     "elType": "widget",
     "widgetType": "html",
     "settings": {
      "html": "<!-- Functional block, kept verbatim. Replace with [gototherapy_search] when the plugin is installed. -->\n<div data-page=\"search\">\n<section class=\"section section--tight section--flush-top\" data-role=\"trainer\" data-search=\"\">\n<div class=\"container\">\n<form action=\"/trainers/\" aria-labelledby=\"filters-title\" class=\"search-card\" data-search-form=\"\" data-search-top=\"\" method=\"get\">\n<p class=\"eyebrow\" id=\"filters-title\">Filter</p>\n<div class=\"filter-bar\">\n<div class=\"search-card__grid search-card__grid--4\">\n<div class=\"form-field\">\n<label class=\"form-field__label\" for=\"f-q\">Search</label>\n<input autocomplete=\"off\" class=\"form-control\" id=\"f-q\" name=\"q\" placeholder=\"Name, town or approach\" type=\"search\"/>\n</div>\n<div class=\"form-field\">\n<label class=\"form-field__label\" for=\"f-location\">Town</label>\n<select class=\"form-control form-control--select\" data-any=\"Anywhere in the UK\" id=\"f-location\" name=\"location\"><option value=\"\">Anywhere in the UK</option></select>\n</div>\n<div class=\"form-field\">\n<label class=\"form-field__label\" for=\"f-issue\">Issue</label>\n<select class=\"form-control form-control--select\" data-any=\"Anything\" id=\"f-issue\" name=\"issue\"><option value=\"\">Anything</option></select>\n</div>\n<div class=\"form-field\">\n<label class=\"form-field__label\" for=\"f-modality\">Approach</label>\n<select class=\"form-control form-control--select\" data-any=\"Any approach\" id=\"f-modality\" name=\"modality\"><option value=\"\">Any approach</option></select>\n</div>\n<div class=\"form-field\">\n<label class=\"form-field__label\" for=\"f-sort\">Sort</label>\n<select class=\"form-control form-control--select\" id=\"f-sort\" name=\"sort\"><option value=\"name\">Name, A to Z</option><option value=\"location\">Town</option><option value=\"recent\">Most recently rechecked</option></select>\n</div>\n<div class=\"form-field\">\n<span class=\"form-field__label\">Format</span>\n<label class=\"form-check\"><input name=\"online\" type=\"checkbox\" value=\"1\"/><span class=\"form-check__label\">Online sessions only</span></label>\n</div>\n<div class=\"form-field\">\n<span class=\"form-field__label\">Availability</span>\n<label class=\"form-check\"><input name=\"accepting\" type=\"checkbox\" value=\"1\"/><span class=\"form-check__label\">Taking new clients</span></label>\n</div>\n</div>\n</div>\n<div class=\"search-card__actions\">\n<button class=\"button button--primary\" type=\"submit\">Show results</button>\n<p class=\"search-card__hint\">Filters narrow the list. Nothing here ranks one therapist above another.</p>\n</div>\n</form>\n<div aria-live=\"polite\" class=\"filter-bar__summary\" data-search-summary=\"\"><p>Loading verified profiles…</p></div>\n<p aria-live=\"polite\" class=\"visually-hidden\" data-search-live=\"\"></p>\n<div class=\"profile-grid\" data-search-results=\"\" style=\"margin-top:1.5rem\" tabindex=\"-1\">\n<noscript><div class=\"empty-state\"><h2 class=\"h3\">Search needs JavaScript in this prototype</h2><p>In production the results are rendered by the server. Meanwhile, browse by <a href=\"/counselling/\">town and issue</a>.</p></div></noscript>\n</div>\n<div data-search-pagination=\"\"></div>\n</div>\n</section>\n</div>"
     },
     "elements": []
    }
