    {
     "id": "43f8e53",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<p>Trainers listed here deliver CPD and course teaching to therapists and trainees. Each is checked against their professional register, has a current insurance certificate, and has had their identity matched to the register entry. Search by town or for online delivery.</p>",
      "_css_classes": "gt-answer"
     },
     "elements": []
    }
   ],
   "isInner": false
  },
  {
   "id": "36ba806",
   "elType": "container",
   "settings": {
    "content_width": "boxed",
    "flex_direction": "column",
    "_css_classes": "gt-section gt-section--tight gt-section--flush-top",
